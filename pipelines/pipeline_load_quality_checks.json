                "connectionSettings": {
                    "name": "STG_Telco_Silver_Layer",
                    "properties": {
                        "annotations": [],
                        "type": "DataWarehouse",
                        "typeProperties": {
                            "endpoint": "75u33zhx4yxezmshig2uxisjby-rssjiscfv5wu3npjf6qqhpfvce.datawarehouse.fabric.microsoft.com",
                            "artifactId": "e8a1cdab-b9fe-4b21-ab82-9349d4da2a2d",
                            "workspaceId": "4894a48c-af45-4d6d-b5e9-2fa103bcb511"
                        },
                        "externalReferences": {
                            "connection": "628b09ef-70bc-40f8-816c-baf2914ad0b8"
                        }
                    }
                },
                "typeProperties": {
                    "scripts": [
                        {
                            "type": "Query",
                            "text": {
                                "value": "INSERT INTO STG_Telco_Silver_Layer.dbo.log_quality_checks_churn               \nSELECT \n    'stg_fact_customer_transactions'                                           AS ETL_TABLE,\n    'check existence of non positive value in billing field'                   AS ETL_CHECKTYPE,\n    'number of rows without positive value: ' + CAST(MAX(row_count) AS VARCHAR) AS DESCRIPTION_RESULT,\n    CASE \n        WHEN MAX(row_count) > 0 THEN 'FAILED' ELSE 'OK'\n    END                                                             AS ETL_RESULT\nFROM \n    (\n    SELECT COUNT(*) AS row_count\n    FROM stg_fact_customer_transactions\n    WHERE MonthlyCharge <= 0\n    ) q;",
                                "type": "Expression"
                            }
                        }
                    ],
                    "scriptBlockExecutionTimeout": "02:00:00"
                }
