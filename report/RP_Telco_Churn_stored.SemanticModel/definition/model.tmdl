model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["fact_customer_transactions","dim_service","dim_date","dim_location","dim_customer"]

annotation PBI_ProTooling = ["DevMode"]

ref table fact_customer_transactions
ref table dim_service
ref table dim_date
ref table dim_location
ref table dim_customer

ref cultureInfo en-US

